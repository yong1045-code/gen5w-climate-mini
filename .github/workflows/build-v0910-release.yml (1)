      - name: Create and verify NEMESIS USB installer
        shell: bash
        run: |
          python3 - <<'PYCODE'
          from pathlib import Path
          import io,zipfile,hashlib,configparser
          apkfile=Path('app/build/outputs/apk/debug/app-debug.apk')
          apk=apkfile.read_bytes()
          if len(apk) < 1000 or not zipfile.is_zipfile(apkfile): raise RuntimeError('APK not built')
          short='Compact climate icons with NAV search auto-hide'
          assert len(short) <= 64
          details='Compact four-icon bar (454x76). NAV search/route draw=2 hides overlay, map draw=1 shows it. Status and logs preserved.'
          assert len(details)<=256
          desc = ('[nemesis]\n'
              'version=1.1\n'
              'id=gen5w.climate.mini\n'
              'name=Gen5W Climate Mini\n'
              'type=application\n'
              'package-version=0.9.10\n'
              'short-desc=Compact climate icons with NAV search auto-hide\n'
              'detailed-desc=Compact four-icon bar (454x76). NAV search/route draw=2 hides overlay, map draw=1 shows it. Status and logs preserved.\n'
              'os=any\nmodels=any\n\n'
              '[app.0]\n'
              'kind=apk\n'
              'path=app/Gen5W-Climate-Mini-v0.9.10.apk\n'
              'package=io.github.gen5w.climatemini\n'
              'component=io.github.gen5w.climatemini/io.github.gen5w.climatemini.MainActivity\n')
          rootdesc='[nemesis]\nversion=1.0\ntype=install\npath=packages/gen5w.climate.mini.zip\n'
          # Validate both descriptors before releasing; avoid the v0.8 literal \n bug.
          cp=configparser.ConfigParser(interpolation=None)
          cp.read_string(desc)
          assert cp.get('nemesis','package-version')=='0.9.10'
          cp2=configparser.ConfigParser(interpolation=None)
          cp2.read_string(rootdesc)
          assert cp2.get('nemesis','type')=='install'
          inner=io.BytesIO()
          with zipfile.ZipFile(inner,'w',zipfile.ZIP_DEFLATED) as z:
              z.writestr('NEMESIS.data',desc)
              z.writestr('app/Gen5W-Climate-Mini-v0.9.10.apk',apk)
          target=Path('Gen5W-Climate-Mini-v0.9.10-NEMESIS-USB.zip')
          with zipfile.ZipFile(target,'w',zipfile.ZIP_DEFLATED) as z:
              z.writestr('NEMESIS.data',rootdesc)
              z.writestr('packages/gen5w.climate.mini.zip',inner.getvalue())
              z.writestr('README-USB.txt','Unzip once. Copy NEMESIS.data + packages/ to USB root.\n'
                  'v0.9.10 fast NAV draw=2 hiding; solid filled HEAT; compact taller buttons; hidden logs via stop long press.\n'
                  'Please test MAP and NAV screen switching while parked.\n')
          with zipfile.ZipFile(target) as z:
              c=configparser.ConfigParser(interpolation=None)
              c.read_string(z.read('NEMESIS.data').decode())
              assert c.get('nemesis','path') == 'packages/gen5w.climate.mini.zip'
              with zipfile.ZipFile(io.BytesIO(z.read(c.get('nemesis','path')))) as pkg:
                  c=configparser.ConfigParser(interpolation=None)
                  c.read_string(pkg.read('NEMESIS.data').decode())
                  assert c.get('nemesis','id') == 'gen5w.climate.mini'
                  assert c.get('app.0','path') in pkg.namelist()
                  assert pkg.read(c.get('app.0','path'))==apk
          print('Valid NEMESIS ZIP:',target,'APK SHA256',hashlib.sha256(apk).hexdigest())
          PYCODE
